# ~/.config/mako/config
# Kanagawa Wave colorscheme

# General
max-visible=5
sort=-time
layer=overlay
anchor=top-right
margin=10
padding=15,20
width=350
height=150
border-size=2
border-radius=8
icons=1
icon-path=/usr/share/icons/Papirus-Dark
max-icon-size=48
markup=1
actions=1
format=<b>%s</b>\n%b
default-timeout=5000
ignore-timeout=0

# Colors (Kanagawa Wave)
background-color=#1F1F28
text-color=#DCD7BA
border-color=#54546D
progress-color=over #7E9CD8

# Urgency: Low
[urgency=low]
background-color=#1F1F28
text-color=#727169
border-color=#363646
default-timeout=3000

# Urgency: Normal
[urgency=normal]
background-color=#1F1F28
text-color=#DCD7BA
border-color=#54546D
default-timeout=5000

# Urgency: Critical
[urgency=critical]
background-color=#2D1F21
text-color=#DCD7BA
border-color=#C34043
default-timeout=0

# App-specific overrides
[app-name=Spotify]
border-color=#76946A

[app-name=discord]
border-color=#7E9CD8

[app-name=slack]
border-color=#957FB8

# Do Not Disturb mode styling
[mode=do-not-disturb]
invisible=1

format=<b>%a</b> (%g)\n%s
