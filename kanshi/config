output "BOE 0x0B22 Unknown" {
  alias $LAPTOP
  mode 3840x2400@60
  position 0,0
  scale 2.0
}

output "Dell Inc. DELL P2725QE FDB7QB4" {
  alias $WORK_MONITOR
  mode 3840x2160@60
  position 1920,0
  scale 1.3
}


output "Dell Inc. DELL U2720Q B9BVW13" {
  alias $HOME_MONITOR
  # for hdmi this can be 30
  mode 3840x2160@59.997
  position 1920,0
  scale 1.3
}

profile home {
    output $LAPTOP enable position 0,240
    output $HOME_MONITOR enable
}

profile work {
    output $LAPTOP enable position 0,462
    output $WORK_MONITOR enable
}
