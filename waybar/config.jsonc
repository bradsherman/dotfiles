{
  "layer": "top",
  "position": "bottom",
  "height": 60,
  "modules-left": [
    "sway/workspaces",
    "custom/playerctl",
    "pulseaudio",
    "sway/mode"
  ],
  "modules-center": [
    "sway/window"
  ],
  "modules-right": [
    "idle_inhibitor",
    "custom/audio_idle_inhibitor",
    "custom/mako",
    "cpu",
    "memory",
    "network",
    "battery",
    // "sway/language",
    "clock",
    "tray"
  ],
  "sway/mode": {
    "format": "{}"
  },
  "sway/workspaces": {
    "format": "{icon} {name}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "9": "",
      "term": "",
      "web": "",
      "slack": "",
      "spotify": "",
      "notes": ""
    },
    "disable-scroll": true,
    "sort-by-number": true
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "tray": {
    "icon-size": 20,
    "spacing": 4
  },
  "sway/window": {
    "format": "{}",
    "max-length": 30,
    "all-outputs": true,
    "offscreen-css": true,
    "offscreen-css-text": "(inactive)",
    "rewrite": {
      "(.*) (.*) Mozilla Firefox": " $1",
      "(.*) - fish": "> [$1]",
      "(.*) - vim": " $1",
      "(.*) - zsh": " [$1]",
      "Zellij(.*)": "Zellij",
      "(.*) - Nvim": " $1"
    }
  },
  "clock": {
    "locale": "en_US.UTF-8",
    "format-alt": " {:%H:%M}",
    "format": " {:%a, %b %d, %Y (%R)}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "locale": "en_US.UTF-8",
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#DCD7BA'><b>{}</b></span>",
        "days": "<span color='#658594'><b>{}</b></span>",
        "weeks": "<span color='#76946A'><b>W{}</b></span>",
        "weekdays": "<span color='#DCA561'><b>{}</b></span>",
        "today": "<span color='#E46876'><b><u>{}</u></b></span>"
      }
    }
  },
  "cpu": {
    "format": "{usage}% ",
    "states": {
      "warning": 80,
      "critical": 90
    }
  },
  "memory": {
    "format": "{}% ",
    "states": {
      "warning": 80,
      "critical": 90
    }
  },
  "backlight": {
    "format": "{percent}% {icon} ",
    "on-scroll-up": "brightnessctl -c backlight set +1%",
    "on-scroll-down": "brightnessctl -c backlight set 1%-",
    "format-icons": [
      "",
      ""
    ]
  },
  "battery": {
    "format": "{capacity}% {icon} ",
    "format-alt": "{time} {icon} ",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "format-charging": "{capacity}% ",
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15
    }
  },
  "network": {
    "format-wifi": "{essid}<big> </big>",
    "format-ethernet": "{ifname}: {ipaddr}/{cidr}  ",
    "format-disconnected": "<small>Disconnected ⚠</small>"
  },
  "pulseaudio": {
    "format": "{icon} {volume}% ",
    "format-bluetooth": "{icon} {volume}% ",
    "format-muted": "",
    "format-icons": {
      "headphones": "",
      "handsfree": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        ""
      ]
    },
    "on-click": "pavucontrol",
    "scroll-step": 10
  },
  "custom/playerctl": {
    "format": "{icon} {text}",
    "return-type": "json",
    "max-length": 40,
    "format-icons": {
        "spotify": "",
        "default": "🎜"
    },
    "escape": true,
    "interval": 1,
    "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "on-scroll-up": "playerctl position 3+",
    "on-scroll-down": "playerctl position 3-"
  },
  "custom/audio_idle_inhibitor": {
    "format": "{icon}",
    "exec": "sway-audio-idle-inhibit --dry-print-both-waybar",
    "exec-if": "which sway-audio-idle-inhibit",
    "return-type": "json",
    "format-icons": {
      "output": "",
      "input": "",
      "output-input": " ",
      "none": ""
    }
  },
  "sway/language": {
    "format": "{short} {variant}",
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
  },
  "custom/mako": {
    "exec": "~/.config/mako/bin/mako-status.sh",
    "return-type": "json",
    "interval": 1,
    "on-click": "~/.config/mako/bin/mako-toggle.sh",
    "tooltip": true
  }
}
